{
  "manifest_version": 3,
  "name": "Eye",
  "short_name": "Eye",
  "version": "1.0.0",
  "description": "Grab any media or piece of a site, keep it in your bin, send it to Storyboardmore or BRN, hand it to an agent, edit any page, and map every page a site has.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Eye",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "identity",
    "scripting",
    "activeTab",
    "sidePanel",
    "notifications",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open Eye"
    },
    "eye-mode": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Eye mode: edit anything on the page"
    },
    "pick-code": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Pick a piece of the page"
    },
    "select-media": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Select media on the page"
    }
  },
  "minimum_chrome_version": "120"
}
